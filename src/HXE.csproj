<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <Prefer32Bit>false</Prefer32Bit>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net462;net480;net6.0-windows;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <StartupObject>HXE.Program</StartupObject>
    <AssemblyName>HXE</AssemblyName>
    <RootNamespace>HXE</RootNamespace>
    <_TargetingLinux>$([System.Text.RegularExpressions.Regex]::IsMatch(
      "$(TargetFramework)_$(RuntimeIdentifier)",
      'net10.0_|_linux'
      ))</_TargetingLinux>
    <DefineConstants Condition="$(_TargetingLinux)">$(DefineConstants);LINUX</DefineConstants>

    <!-- Application | Resources -->
    <ApplicationIcon>Assets/icon.ico</ApplicationIcon>
    <!-- Build | General -->
    <Deterministic>true</Deterministic>
    <FileAlignment>512</FileAlignment>
    <Nullable>enable</Nullable>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>

    <!-- Build | Events -->
    <!-- Ensures GitVersion, SourceLink tasks only run after successful builds -->
    <RunPostBuildEvent>OnBuildSuccess</RunPostBuildEvent>

    <!-- Build | Strong Naming -->

    <NET462_OR_GREATER>$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net462'))</NET462_OR_GREATER>
    <NET5_0_OR_GREATER>$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net5.0'))</NET5_0_OR_GREATER>
    <NET6_0_OR_GREATER>$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net6.0'))</NET6_0_OR_GREATER>
    <NET7_0_OR_GREATER>$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net7.0'))</NET7_0_OR_GREATER>
    <NET8_0_OR_GREATER>$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))</NET8_0_OR_GREATER>

    <!-- Publish -->
    <IsTrimmable>$(NET6_0_OR_GREATER)</IsTrimmable>
    <EnableTrimAnalyzer>$(IsTrimmable)</EnableTrimAnalyzer>
    <IsAotCompatible>$(NET8_0_OR_GREATER)</IsAotCompatible>
    <EnableAotAnalyzer>$(IsAotCompatible)</EnableAotAnalyzer>
    <VerifyReferenceAotCompatibility>$(IsAotCompatible)</VerifyReferenceAotCompatibility>
    <!-- Waiting for trim-compatible WPF -->
    <!--<PublishTrimmed>true</PublishTrimmed> -->
    <PublishSingleFile Condition="'$(Configuration)' == 'Release'">$(NET6_0_OR_GREATER)</PublishSingleFile>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' AND '$(PublishSingleFile)' == 'true'">win7-x86</RuntimeIdentifier>
    <RuntimeIdentifier Condition="$(NET7_0_OR_GREATER)">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="$(NET7_0_OR_GREATER) AND !$(TargetFramework.Contains('windows'))">linux-x64</RuntimeIdentifier>
    <SelfContained Condition="'$(SelfContained)' == '' AND '$(RuntimeIdentifier)' != '' AND '$(NET6_0_OR_GREATER)' == 'true'">true</SelfContained>
    <PublishSingleFile Condition="'$(PublishSingleFile)' == 'true' AND $(RuntimeIdentifier.Contains('win7'))">$([MSBuild]::VersionGreaterThanOrEquals($(NETCoreSdkVersion), '6.0.300'))</PublishSingleFile>

    <!-- Misc -->
    <ProjectGuid>{ACAA5D9F-B23D-43E1-B2DF-8C03230975A1}</ProjectGuid>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <ProductName>HXE</ProductName>
    <PublisherName>Halo SPV3 Team</PublisherName>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <ToolCommandName>hxe</ToolCommandName>
    <UseWPF Condition="!$(_TargetingLinux)">true</UseWPF>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Changing this to "true" will cause a crash when loading any GUI -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <!-- T:System.Runtime.CompilerServices.OverloadResolutionPriorityAttribute is polyfilled by CsWin32 -->
    <MeziantouPolyfill_ExcludedPolyfills>T:System.Runtime.CompilerServices.OverloadResolutionPriorityAttribute</MeziantouPolyfill_ExcludedPolyfills>
    <!-- If true, use XmlSourceGenerator by ProjectReference via git submodule instead of by PackageReference -->
    <UseBleedingEdgeXSGen>true</UseBleedingEdgeXSGen>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
  </PropertyGroup>

  <ItemGroup Label="Assembly Attributes">
    <!-- Mark assemblies with NeutralResourcesLanguageAttribute (CA1824) https://learn.microsoft.com/en-us/dotnet/fundamentals/code-analysis/quality-rules/ca1824
      https://stackoverflow.com/questions/77245575/how-to-set-neutralresourceslanguageattribute-in-my-net-core-project -->
    <AssemblyAttribute Include="System.Resources.NeutralResourcesLanguageAttribute">
      <_Parameter1>en</_Parameter1>
    </AssemblyAttribute>
    <InternalsVisibleTo Include="$(AssemblyName).Tests" />
  </ItemGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <!--  -->
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>

  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>$(NET6_0_OR_GREATER)</EnableCompressionInSingleFile>
  </PropertyGroup>

  <PropertyGroup Label="Nuget Properties">
    <_changelogPath>$([System.IO.Path]::GetFullPath($(MSBuildProjectDirectory)/../CHANGELOG.md))</_changelogPath>
    <Authors>HaloSPV3</Authors>
    <Copyright>Copyright © 2026 Noah Sherwin</Copyright>
    <Description>A HCE wrapper and SPV3 loader</Description>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <IncludeSource>true</IncludeSource>
    <IncludeSymbols>true</IncludeSymbols>
    <PackageIcon>icon.png</PackageIcon>
    <PackageIconUrl>https://github.com/HaloSPV3/HXE/blob/main/src/Assets/icon.png</PackageIconUrl>
    <PackageLicenseExpression>Zlib</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/HaloSPV3/HXE</PackageProjectUrl>
    <PackageReadmeFile>readme.md</PackageReadmeFile>
    <PackageReleaseNotes Condition="Exists($(_changelogPath))">$([System.IO.File]::ReadAllText($(_changelogPath)))</PackageReleaseNotes>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageTags>Halo</PackageTags>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/HaloSPV3/HXE</RepositoryUrl>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup Label="None, Content, EmbeddedResource">
    <None Include="../.github/**/*.*">
      <Link>.github/%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
    <None Include="../doc/**/*.*">
      <Link>.docs/%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
    <None Include="../*.md">
      <Link>.docs-misc/%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
    <None Include="*.txt">
      <Link>.docs-misc/%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
    <None Include="src.licenseheader">
      <Link>.docs-misc/%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>

    <!-- Campaign Support -->
    <Content Include="Campaigns/*.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>%(FileName).xml</TargetPath>
    </Content>

    <!-- Assets -->
    <!-- Default Include normally handled by EnableDefaultEmbeddedResourceItems -->
    <EmbeddedResource Include="**/*.resx" />
    <NonLocalizedResx Include="Resources/**/*.resx" Exclude="Resources/**/*.de.resx;Resources/**/*.en.resx" />
    <EmbeddedResource Update="@(NonLocalizedResx)">
      <Generator>MSBuild:Compile</Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="Properties/Resources.resx" EmitFormatMethods="true" WithCulture="false">
      <Generator>MSBuild:Compile</Generator><!-- Tell Visual Studio to run a build if the resx file changes -->
    </EmbeddedResource>
    <EmbeddedResource Include="Assets/343I_DER.cer" />
    <Content Include="Assets/icon.ico" />
  </ItemGroup>

  <ItemGroup Label="NuGet Package Items">
    <None Include="Assets/icon.png" Pack="true" PackagePath="/" />
    <None Include="../readme.md" Pack="true" PackagePath="/">
      <Link>.docs-misc/readme.md</Link>
    </None>
  </ItemGroup>

  <ItemGroup Label="Package References">
    <PackageReference Include="GitVersion.MsBuild" Version="6.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Meziantou.Polyfill" Version="1.0.157">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.298">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Condition="'$(UseBleedingEdgeXSGen)' == 'false'" Include="XmlSourceGenerator" Version="1.0.2-alpha" />
    <!-- ReferenceOutputAssembly must be true so Attributes can be accessed -->
    <ProjectReference Condition="'$(UseBleedingEdgeXSGen)' == 'true'" Include="../ext/XmlSourceGenerator/src/XmlSourceGenerator/XmlSourceGenerator.csproj" OutputItemType="Analyzer" PrivateAssets="all" ReferenceOutputAssembly="false" SetTargetFramework="TargetFramework=netstandard2.0" />
    <ProjectReference Condition="'$(UseBleedingEdgeXSGen)' == 'true'" Include="../ext/XmlSourceGenerator/src/XmlSourceGenerator.Abstractions/XmlSourceGenerator.Abstractions.csproj" SetTargetFramework="TargetFramework=netstandard2.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="LinuxDesktopUtils.XDGDesktopPortal" Version="1.0.2" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.95.0" />
  </ItemGroup>

  <Choose>
    <When Condition="$(TargetFramework.StartsWith('net4'))">
      <PropertyGroup Label="Additional Properties (NET4)">
        <!-- Disabling these two properties prevents the output of (App).exe.config. Yippee! But a bunch of warning are spat out, instead. Boooo! -->
        <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
        <GenerateSupportedRuntime>true</GenerateSupportedRuntime>
        <WeaverConfiguration>
          <Weavers>
            <Costura />
          </Weavers>
        </WeaverConfiguration>
      </PropertyGroup>
      <ItemGroup Label="Additional References (NET4)">
        <PackageReference Include="Costura.Fody" Version="6.2.0"
          PrivateAssets="all" />
        <PackageReference Include="System.Memory" Version="4.6.3" />
        <PackageReference Include="System.Text.Json" Version="10.0.11" />
        <Reference Condition="'$(TargetFramework)' == 'net462'" Include="System.Net.Http" Version="4.0.0.0" Culture="neutral" PublicKeyToken="b03f5f7f11d50a3a" />
        <Reference Condition="'$(TargetFramework)' == 'net480'" Include="System.Net.Http" Version="4.2.0.0" Culture="neutral" PublicKeyToken="b03f5f7f11d50a3a" />
        <Reference Condition="'$(TargetFramework)' == 'net462'" Include="System.IO.Compression" Version="4.0.0.0" Culture="neutral" PublicKeyToken="b77a5c561934e089" />
        <Reference Condition="'$(TargetFramework)' == 'net480'" Include="System.IO.Compression" Version="4.2.0.0" Culture="neutral" PublicKeyToken="b77a5c561934e089" />
      </ItemGroup>

    </When>
  </Choose>

  <Target Name="PreBuild" BeforeTargets="PreBuildEvent">
    <Exec Command="pwsh $(MSBuildProjectDirectory)/.msb.prebuild.ps1" />
  </Target>
</Project>
