{
  "name": "hxe",
  "description": "Automate commit messages quality, automate changelog and release generation",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.0.0"
  },
  "devEngines": {
    "runtime": {
      "onFail": "error",
      "name": "node",
      "version": "24.18.0"
    }
  },
  "scripts": {
    "build": "dotnet build -c:Debug && dotnet build -c:Release",
    "postinstall": "husky",
    "lint": "eslint --cache",
    "release": "semantic-release --debug",
    "restore": "dotnet restore -p:Configuration=Debug && dotnet restore -p:Configuration=Release",
    "test": "dotnet test"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^21.2.0",
    "@commitlint/types": "^21.2.0",
    "@dotenvx/dotenvx": "^2.19.0",
    "@halospv3/hce.shared-config": "^3.13.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@tsconfig/node24": "^24.0.4",
    "@types/debug": "^4.1.13",
    "@types/node": "^24.13.3",
    "commitlint": "^21.2.1",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "eslint": "^10.8.0",
    "eslint-plugin-unicorn": "^72.0.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "semantic-release": "^25.0.8",
    "semantic-release-export-data": "^1.2.0",
    "typescript": "^6.0.3"
  },
  "packageManager": "yarn@4.18.1+sha512.107f80e13c40b41597284d03190c56f41a3d72b5c72c9ef799fc634d026ebfc5e89cd5964e97a2f014392637331c9354f4644e4f27303059fc88ebd12195d470",
  "resolutions": {
    "import-from-esm@npm:^2.0.0": "patch:import-from-esm@npm%3A2.0.0#~/.yarn/patches/import-from-esm-npm-2.0.0-8866147795.patch"
  },
  "allowScripts": {
    "@halospv3/hce.shared-config": false
  }
}
