{
  "name": "hxe",
  "description": "Automate commit messages quality, automate changelog and release generation",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.0.0"
  },
  "devEngines": {
    "runtime": {
      "onFail": "error",
      "name": "node",
      "version": "24.22.1"
    }
  },
  "scripts": {
    "build": "dotnet build -c:Debug && dotnet build -c:Release",
    "postinstall": "husky",
    "lint": "eslint --cache",
    "release": "semantic-release --debug",
    "restore": "dotnet restore -p:Configuration=Debug && dotnet restore -p:Configuration=Release",
    "sdks": "yarn dlx @yarnpkg/sdks@2 vscode",
    "test": "dotnet test"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@dotenvx/dotenvx": "^2.38.2",
    "@halospv3/hce.shared-config": "^3.13.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@tsconfig/node24": "^24.0.5",
    "@types/debug": "^4.1.13",
    "@types/node": "^24.19.2",
    "commitlint": "^21.2.4",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "eslint": "^10.13.0",
    "eslint-plugin-unicorn": "^79.0.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "semantic-release": "^25.0.9",
    "semantic-release-export-data": "^1.2.0",
    "typescript": "^6.0.3"
  },
  "packageManager": "yarn@4.18.1+sha512.b2e1e7524f654f2749d32b4ebcb4622473cb5bcbc485df2007e12a154e50162a4d795526768bc5f5b8f81717bfd79deb2472813d86fb5ae2eb551fa9c872b08f",
  "resolutions": {
    "import-from-esm@npm:^2.0.0": "patch:import-from-esm@npm%3A2.0.0#~/.yarn/patches/import-from-esm-npm-2.0.0-8866147795.patch"
  },
  "allowScripts": {
    "@halospv3/hce.shared-config": false
  }
}
