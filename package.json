{
  "name": "hxe",
  "description": "Automate commit messages quality, automate changelog and release generation",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.0.0"
  },
  "devEngines": {
    "runtime": {
      "onFail": "error",
      "name": "node",
      "version": "24.18.0"
    }
  },
  "scripts": {
    "build": "dotnet build -c:Debug && dotnet build -c:Release",
    "postinstall": "husky",
    "lint": "eslint --cache",
    "release": "semantic-release --debug",
    "restore": "dotnet restore -p:Configuration=Debug && dotnet restore -p:Configuration=Release",
    "test": "dotnet test"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^21.2.2",
    "@commitlint/types": "^21.2.0",
    "@dotenvx/dotenvx": "^2.23.0",
    "@halospv3/hce.shared-config": "^3.13.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@tsconfig/node24": "^24.0.5",
    "@types/debug": "^4.1.13",
    "@types/node": "^26.4.0",
    "commitlint": "^21.2.2",
    "conventional-changelog-conventionalcommits": "^10.4.0",
    "eslint": "^10.9.1",
    "eslint-plugin-unicorn": "^74.0.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "semantic-release": "^25.0.9",
    "semantic-release-export-data": "^1.2.0",
    "typescript": "^7.0.2"
  },
  "packageManager": "yarn@4.18.0+sha512.fcb8716fe7cd0eece141ffc18b92193a9df9204c1ba83189c288835223fc0bbe64af473bab0d5e9927a7daeb5caf2bb07eb2787cc9338ca040ea125f2a1f2f7e",
  "resolutions": {
    "import-from-esm@npm:^2.0.0": "patch:import-from-esm@npm%3A2.0.0#~/.yarn/patches/import-from-esm-npm-2.0.0-8866147795.patch"
  },
  "allowScripts": {
    "@halospv3/hce.shared-config": false
  }
}
